SELECT
  s.id,
  s.title,
  s.directory,
  s.slug,
  s.agent,
  s.model,
  s.time_updated
FROM session s
WHERE s.parent_id IS NULL
  AND s.time_archived IS NULL
ORDER BY s.time_updated DESC
"""

